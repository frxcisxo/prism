{
  "name": "@frxncisxo/prism",
  "version": "1.0.2",
  "type": "module",
  "description": "CRDT-first edge AI orchestration toolkit with distributed sync, resilient inference runtimes, verified demos, and typed TypeScript APIs.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "require": "./dist/edge.cjs"
    },
    "./inference": {
      "types": "./dist/inference.d.ts",
      "import": "./dist/inference.js",
      "require": "./dist/inference.cjs"
    }
  },
  "files": [
    "dist",
    "demo.js",
    "demo-onnx.js",
    "examples/visual-console",
    "examples/cloudflare-worker",
    "test/fixtures/onnx/add-one.onnx",
    "README.md",
    "COMMERCIAL_SUPPORT.md",
    "SAMPLE_SNAPSHOT_REPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/edge.ts src/inference.ts --format cjs,esm --dts --minify --sourcemap --clean",
    "build:optimized": "tsup src/index.ts src/edge.ts src/inference.ts --format cjs,esm --dts --minify --sourcemap --target es2022 --clean",
    "dev": "tsup src/index.ts src/edge.ts src/inference.ts --format cjs,esm --dts --watch",
    "demo": "node demo.js",
    "demo:onnx": "node demo-onnx.js",
    "demo:all": "node demo.js && node demo-onnx.js",
    "example:visual": "node examples/visual-console/server.js",
    "example:cloudflare": "node examples/cloudflare-worker/local-smoke.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:performance": "vitest --run --reporter=verbose bench/",
    "validate": "npm run build && node validate-readme.js && npm run example:cloudflare && node validate-visual-console.js && node validate-packaged-demo.js",
    "ci": "npm run type-check && npm test -- --run && npm run build && node validate-readme.js && npm run example:cloudflare && node validate-visual-console.js && node validate-packaged-demo.js && npm audit --omit=dev && npm pack --dry-run",
    "lint": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "size-check": "npm run build && du -sh dist/",
    "prepublishOnly": "npm run type-check && npm run build:optimized && npm test -- --run && node validate-readme.js && npm run example:cloudflare && node validate-visual-console.js && node validate-packaged-demo.js"
  },
  "keywords": [
    "edge-ai",
    "inference",
    "distributed",
    "ml-models",
    "edge-computing",
    "crdt",
    "real-time-sync",
    "llm",
    "typescript",
    "performance",
    "reliability"
  ],
  "author": "Francisco Molina <frxcisxo@dev.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frxcisxo/prism"
  },
  "bugs": {
    "url": "https://github.com/frxcisxo/prism/issues"
  },
  "homepage": "https://github.com/frxcisxo/prism",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "onnxruntime-web": "^1.27.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "libsodium-wrappers": "^0.7.13",
    "node-fetch": "^3.3.2",
    "onnxruntime-web": "^1.27.0",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.20.0 <2"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
